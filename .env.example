# Turso — copia estos valores desde el panel de Turso o desde la CLI
TURSO_DATABASE_URL="libsql://tu-base-tu-organizacion.turso.io"
TURSO_AUTH_TOKEN="tu-auth-token-de-turso"

# Panel privado — opcional. Si se deja vacío, se usa la contraseña de
